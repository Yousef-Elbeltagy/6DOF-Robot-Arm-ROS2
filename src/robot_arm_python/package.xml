<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_python</name>
  <version>0.1.0</version>
  <description>Python/Tkinter operator interface and ROS 2 control logic for the 6-DOF robot arm, sequence programming, and automatic jig placement.</description>
  <maintainer email="Yousef-Elbeltagy@users.noreply.github.com">Yousef El-Beltagy</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>pymoveit2</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>linkattacher_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
